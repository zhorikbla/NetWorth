# Скопируйте этот файл в .env и подставьте свои значения.
# .env не должен попадать в git — он уже добавлен в .gitignore.

# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/networth"
JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=1h
PORT=3000
